# Copy this file to .env and fill in real values. .env is git-ignored and
# must never be committed. See README for how each variable is used.

# LLM provider key for the RAG generation step (rag/generation/).
# Used only to phrase the final answer from graph evidence already retrieved
# by Cypher — never sent the raw question or anything outside that evidence.
# Free tier, no billing required. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: caps spend/latency risk and picks the model for a live demo.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_TOKENS=512
GEMINI_TIMEOUT_SECONDS=10
