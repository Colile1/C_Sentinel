# deploy/.env.example - every environment variable the stack reads, with safe
# placeholder values. Copy to deploy/.env (git-ignored) before `docker compose
# up`. No real secret ever lives in this file.
#
#   cp deploy/.env.example deploy/.env
#
# Compose substitutes ${VAR} in docker-compose.yml from deploy/.env. Each
# service's DATABASE_URL is assembled in docker-compose.yml from the *_DB_USER,
# *_DB_PASSWORD and *_DB_NAME below, so the only place a password is written is
# its *_DB_PASSWORD variable - never a full connection string. Every service
# still receives exactly one DATABASE_URL, its own (D-04, Database-per-Service).
#
# Author: Colile

# --- JWT (shared by auth-service and the Kong gateway) ----------------------
# HS256 signing key. Must be at least 16 characters (config.py rejects shorter).
# Generate a real one for every run, throwaway or not:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
# docker-compose.yml passes this same value to Kong as KONG_JWT_SECRET, which
# gateway/kong.yml interpolates into its jwt_secrets credential - so the gateway
# validates tokens it did not issue without any key literal being checked in.

# --- Kong API gateway -------------------------------------------------------
# The gateway's own log verbosity. One of debug, info, notice, warn, error.
# Its routing, JWT and rate-limiting configuration is gateway/kong.yml, not
# environment variables - DB-less Kong reads that file at start.
KONG_LOG_LEVEL=notice

# --- Logging ----------------------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# --- Consul registry ------------------------------------------------------
# The agent address on the Compose network. Services self-register at startup;
# a registry outage does not stop a service (registry/README.md).
CONSUL_HOST=consul
CONSUL_PORT=8500
CONSUL_ENABLED=true

# --- PostgreSQL, one role per service ------------------------------------
# Each *_DB_* triplet configures one database container. The matching
# DATABASE_URL below is the only connection string its service is given.
# Set every *_DB_PASSWORD to a value you generate yourself before first run:
#   openssl rand -hex 16
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=CHANGE_ME

INCIDENT_DB_NAME=incident_db
INCIDENT_DB_USER=incident_service
INCIDENT_DB_PASSWORD=CHANGE_ME

ASSET_DB_NAME=asset_db
ASSET_DB_USER=asset_service
ASSET_DB_PASSWORD=CHANGE_ME

# Each service's DATABASE_URL (postgresql+psycopg://user:pw@host:5432/db) is
# built from the three variables above inside docker-compose.yml. There is
# deliberately no *_DATABASE_URL entry here - keeping the password out of any
# checked-in connection string.

# --- Inter-service call (incident-service -> asset-service only) ---------
# Read exclusively through libs/common/http_client.ResilientClient (D-14, step 8).
ASSET_SERVICE_URL=http://asset-service:8003

# --- Resilience thresholds (libs/common/http_client.py) -----------------
# Demo-friendly values: the breaker opens after 3 failed calls and re-tests
# after 15s, both short enough to show on camera (config.py comment).
DEPENDENCY_TIMEOUT_SECONDS=3.0
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=0.2
CIRCUIT_FAIL_MAX=3
CIRCUIT_RESET_SECONDS=15.0
