# deploy/.env.example - every environment variable the stack reads, with safe
# placeholder values. Copy to deploy/.env (git-ignored) before `docker compose
# up`. No real secret ever lives in this file.
#
#   cp deploy/.env.example deploy/.env
#
# Compose substitutes ${VAR} in docker-compose.yml from deploy/.env. The three
# services each receive exactly one DATABASE_URL - their own, never another's
# (D-04, the Database-per-Service pattern).
#
# Author: Colile

# --- JWT (shared by auth-service and, from step 10, the Kong gateway) --------
# HS256 signing key. Must be at least 16 characters (config.py rejects shorter).
# Generate a real one for any non-throwaway run:  openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- Logging ----------------------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# --- Consul registry ------------------------------------------------------
# The agent address on the Compose network. Services self-register at startup;
# a registry outage does not stop a service (registry/README.md).
CONSUL_HOST=consul
CONSUL_PORT=8500
CONSUL_ENABLED=true

# --- PostgreSQL, one role per service ------------------------------------
# Each *_DB_* triplet configures one database container. The matching
# DATABASE_URL below is the only connection string its service is given.
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=dev-only-auth-pw

INCIDENT_DB_NAME=incident_db
INCIDENT_DB_USER=incident_service
INCIDENT_DB_PASSWORD=dev-only-incident-pw

ASSET_DB_NAME=asset_db
ASSET_DB_USER=asset_service
ASSET_DB_PASSWORD=dev-only-asset-pw

# --- Per-service DATABASE_URL (psycopg 3 driver) ------------------------
# Host is the database container's Compose service name; port is the
# in-network 5432, not a published port. These reference the values above.
AUTH_DATABASE_URL=postgresql+psycopg://auth_service:dev-only-auth-pw@auth-db:5432/auth_db
INCIDENT_DATABASE_URL=postgresql+psycopg://incident_service:dev-only-incident-pw@incident-db:5432/incident_db
ASSET_DATABASE_URL=postgresql+psycopg://asset_service:dev-only-asset-pw@asset-db:5432/asset_db

# --- Inter-service call (incident-service -> asset-service only) ---------
# Read exclusively through libs/common/http_client.ResilientClient (D-14, step 8).
ASSET_SERVICE_URL=http://asset-service:8003

# --- Resilience thresholds (libs/common/http_client.py) -----------------
# Demo-friendly values: the breaker opens after 3 failed calls and re-tests
# after 15s, both short enough to show on camera (config.py comment).
DEPENDENCY_TIMEOUT_SECONDS=3.0
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=0.2
CIRCUIT_FAIL_MAX=3
CIRCUIT_RESET_SECONDS=15.0
