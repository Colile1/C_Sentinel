/><Array as="points"><mxPoint x="432" y="231" /><mxPoint x="588" y="231" /></Array></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F2933;fontSize=8;fontColor=#4A5568;exitPerimeter=0;entryPerimeter=0;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_incident" target="n_asset"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="306" as="sourcePoint" /><mxPoint x="530" y="306" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F2933;fontSize=8;fontColor=#4A5568;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_auth" target="n_authdb"><mxGeometry relative="1" as="geometry"><mxPoint x="188" y="336" as="sourcePoint" /><mxPoint x="188" y="382" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F2933;fontSize=8;fontColor=#4A5568;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_incident" target="n_incdb"><mxGeometry relative="1" as="geometry"><mxPoint x="388" y="336" as="sourcePoint" /><mxPoint x="388" y="382" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F2933;fontSize=8;fontColor=#4A5568;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_asset" target="n_assetdb"><mxGeometry relative="1" as="geometry"><mxPoint x="588" y="336" as="sourcePoint" /><mxPoint x="588" y="382" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F2933;fontSize=8;fontColor=#4A5568;exitPerimeter=0;entryPerimeter=0;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.551;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_consul" target="g_svcgrp"><mxGeometry relative="1" as="geometry"><mxPoint x="692" y="306" as="sourcePoint" /><mxPoint x="660" y="306" as="targetPoint" /></mxGeometry></mxCell><mxCell id="b_p1" value="&lt;b&gt;PATTERN 1 — Database per Service&lt;/b&gt;&lt;br&gt;Three separate PostgreSQL containers; each service holds exactly one DATABASE_URL   ·   No service reads another's tables; incident-service stores an asset id and a name snapshot, never a foreign key into asset-db" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F7F9FB;strokeColor=#B7C0CC;align=left;verticalAlign=middle;spacingLeft=10;fontSize=9;fontColor=#4A5568;" vertex="1" parent="1"><mxGeometry x="120" y="466" width="536" height="70" as="geometry" /></mxCell><mxCell id="b_p2" value="&lt;b&gt;PATTERN 2 — Circuit Breaker with Retry&lt;/b&gt;&lt;br&gt;incident-service calls asset-service only through libs/common/http_client.py   ·   tenacity retry nested inside a pybreaker circuit breaker; fallback keeps incident creation working while the dependency is down" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F7F9FB;strokeColor=#B7C0CC;align=left;verticalAlign=middle;spacingLeft=10;fontSize=9;fontColor=#4A5568;" vertex="1" parent="1"><mxGeometry x="120" y="558" width="536" height="70" as="geometry" /></mxCell><mxCell id="b_obs" value="&lt;b&gt;Observability and security-event collection&lt;/b&gt;&lt;br&gt;Prometheus scrapes /metrics on every service; Grafana dashboards   ·   Every service emits one-line JSON security events on a fixed schema   ·   X-Correlation-ID minted at the gateway, carried through every service" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F7F9FB;strokeColor=#B7C0CC;align=left;verticalAlign=middle;spacingLeft=10;fontSize=9;fontColor=#4A5568;" vertex="1" parent="1"><mxGeometry x="120" y="650" width="536" height="84" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>